:root {
    --main-bg: #050505;
    --card-bg: #121212;
    --accent: #bb86fc;
    --text: #e1e1e1;
    --dim: #888;
}

* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

body {
    margin: 0;
    font-family: 'Segoe UI', Roboto, sans-serif;
    background-color: var(--main-bg);
    color: var(--text);
    overflow: hidden;
}

.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background: var(--card-bg);
    border-bottom: 1px solid #222;
}

#app-shell {
    height: calc(100vh - 135px);
    overflow-y: auto;
    padding: 20px;
}

.bottom-nav {
    position: fixed;
    bottom: 0;
    width: 100%;
    height: 70px;
    background: #121212;
    display: flex;
    justify-content: space-around;
    align-items: center;
    border-top: 1px solid #222;
    z-index: 100;
}

.nav-item {
    text-decoration: none !important;
    color: var(--dim);
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 11px;
    transition: 0.3s;
}

.nav-item.active {
    color: var(--accent);
}

.quest-card, .profile-card {
    background: var(--card-bg);
    padding: 20px;
    border-radius: 20px;
    margin-bottom: 15px;
    border: 1px solid #222;
}

.accent-border {
    border-left: 4px solid var(--accent);
}

h1 { font-size: 24px; margin-bottom: 20px; }
.material-icons { font-size: 26px; margin-bottom: 4px; }
