:root {
    --main-bg: #050505;
    --card-bg: #121212;
    --accent: #bb86fc;
    --text: #e1e1e1;
}

body {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    background-color: var(--main-bg);
    color: var(--text);
    overflow: hidden; /* Чтобы не было лишнего скролла всей страницы */
}

.top-bar {
    display: flex;
    justify-content: space-between;
    padding: 15px 20px;
    background: var(--card-bg);
    border-bottom: 1px solid #333;
}

#app-shell {
    height: calc(100vh - 130px); /* Вычитаем высоту хедера и навигации */
    overflow-y: auto;
    padding: 20px;
}

.bottom-nav {
    position: fixed;
    bottom: 0;
    width: 100%;
    height: 70px;
    background: #121212;
    display: flex;
    justify-content: space-around;
    align-items: center;
    border-top: 1px solid #333;
}

.nav-item {
    text-decoration: none;
    color: #888;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 12px;
}

.nav-item.active {
    color: var(--accent);
}

.material-icons { font-size: 28px; }

